---
import { gallery } from '../../data/gallery';
import Lightbox from '../ui/Lightbox.astro';
import VirtualTour from '../ui/VirtualTour.astro';

// Keep each photo's index in the full list so the lightbox opens the right one.
const indexed = gallery.map((g, i) => ({ ...g, i }));
const featured = indexed.filter((g) => g.featured);
const rest = indexed.filter((g) => !g.featured);
---

<section id="clinic" aria-labelledby="clinic-title" class="section-y !pt-0">
  <div class="wrap">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker">Inside the clinic</p>
        <h2 id="clinic-title" class="h-section">A separate surgical section, daylight, and equipment you can see being cleaned.</h2>
      </div>
      <p class="text-[15px] text-slate-soft sm:text-[15.5px] lg:col-span-4 lg:col-start-9">
        Instruments go through a Class B autoclave after every patient, and each pouch is opened at the chair.
      </p>
    </div>

    {/* Highlight: the separate surgical section, shown from two angles */}
    <div class="reveal mt-8 rounded-md border border-clinic/30 bg-enamel p-3 sm:mt-10 sm:p-5 md:p-6">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2 sm:mb-5">
        <p class="inline-flex items-center gap-2 rounded-full bg-clinic px-3 py-1 font-display text-[12.5px] font-semibold uppercase tracking-[0.12em] text-white">
          Clinic highlight
        </p>
        <p class="text-[14px] text-slate-soft sm:text-[15px]">
          A dedicated surgical section, kept apart from routine check-ups.
        </p>
      </div>
      <ul class="grid gap-3 md:grid-cols-2 md:gap-4">
        {
          featured.map((g) => (
            <li>
              <button
                type="button"
                data-lightbox-index={g.i}
                class="group relative block w-full overflow-hidden rounded-md text-left"
                aria-label={`Open photo: ${g.caption}`}
              >
                <img
                  src={g.src}
                  alt={g.alt}
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
                <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink-deep/85 to-transparent px-4 pb-3.5 pt-12 font-display text-[17px] font-semibold leading-snug text-white sm:text-[19px]">
                  {g.caption}
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="reveal stagger mt-6 grid grid-cols-2 gap-3 sm:mt-8 md:grid-cols-4 md:gap-4">
      {
        rest.map((g) => (
          <li>
            <button
              type="button"
              data-lightbox-index={g.i}
              class="group block w-full overflow-hidden rounded-md text-left"
              aria-label={`Open photo: ${g.caption}`}
            >
              <img
                src={g.src}
                alt={g.alt}
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </button>
            <p class="mt-1.5 text-[12.5px] leading-snug text-slate-soft sm:mt-2 sm:text-[13px]">{g.caption}</p>
          </li>
        ))
      }
    </ul>

    <VirtualTour />
  </div>
  <Lightbox items={gallery} />
</section>
