---
import { Check } from '@lucide/astro';

const promise = [
  'A written treatment plan explaining each step — before we start.',
  'Options explained side by side (for example implant vs bridge), including doing nothing.',
  'A new sterilised instrument kit for every patient, opened in front of you.',
  'A re-check visit within 30 days of any filling, root canal or crown.',
];
---

<section id="about" aria-labelledby="about-title" class="section-y">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="reveal relative lg:col-span-5">
      <img
        src="/images/clinic-operatory.jpg"
        alt="Treatment room at the clinic with dental chair and overhead lamp"
        class="aspect-[4/3] w-full rounded-md object-cover md:aspect-[16/9] lg:aspect-[4/5]"
        loading="lazy"
        width="1200"
        height="1500"
      />
    </div>

    <div class="reveal lg:col-span-7 lg:pl-8">
      <h2 id="about-title" class="kicker">About the clinic</h2>
      <div class="mt-5 max-w-2xl space-y-4 text-[16px] sm:mt-6 sm:text-[17px]">
        <p>
          We provide a clean, modern and welcoming environment designed to make every patient feel
          comfortable and at ease. The clinic features a soothing interior with refreshing green tones,
          nature-inspired elements, spacious treatment areas and a well-organised layout.
        </p>
        <p>
          Our thoughtfully designed surroundings create a calm and positive atmosphere, helping reduce
          dental anxiety while ensuring a comfortable treatment experience. With a strong emphasis on
          hygiene, comfort, privacy and patient care, every aspect of the clinic is designed with the
          patient’s well-being in mind.
        </p>
      </div>

      <div class="mt-8 border-t border-line pt-7 sm:mt-10 sm:pt-8">
        <h3 class="font-display text-[19px] font-bold">Our clinic promise</h3>
        <ul class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            promise.map((p) => (
              <li class="flex gap-3 text-[15.5px] leading-snug">
                <Check class="mt-0.5 h-5 w-5 shrink-0 text-clinic" stroke-width={2.2} />
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
