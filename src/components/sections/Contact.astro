---
import { MapPin, Phone, Mail, Car, Navigation } from '@lucide/astro';
import { site } from '../../data/site';
import { clinicHours } from '../../data/hours';
import OpenBadge from '../ui/OpenBadge.astro';

const row = 'flex gap-3.5 border-b border-line py-4';
---

<section id="contact" aria-labelledby="contact-title" class="bg-enamel">
  <div class="grid lg:grid-cols-2">
    <div class="wrap py-12 sm:py-16 md:py-20 lg:ml-auto lg:mr-0 lg:max-w-[600px] lg:pr-14">
      <p class="kicker">Find us</p>
      <h2 id="contact-title" class="h-section">Third floor, Krystal Square, Nagala Park.</h2>
      <OpenBadge class="mt-5" />
      <ul class="mt-6 border-t sm:mt-8 border-line text-[15.5px]">
        <li class={row}>
          <MapPin class="mt-0.5 h-5 w-5 shrink-0 text-clinic-dark" />
          <span>{site.addressLines.join(', ')}<br /><span class="text-slate-soft">{site.landmark}</span></span>
        </li>
        <li class={row}>
          <Phone class="mt-0.5 h-5 w-5 shrink-0 text-clinic-dark" />
          <a href={`tel:${site.phoneRaw}`} class="-my-2 py-2 font-semibold text-ink hover:text-action">{site.phoneDisplay}</a>
        </li>
        <li class={row}>
          <Mail class="mt-0.5 h-5 w-5 shrink-0 text-clinic-dark" />
          <a href={`mailto:${site.email}`} class="-my-2 break-all py-2 hover:text-action">{site.email}</a>
        </li>
        <li class={row}>
          <Car class="mt-0.5 h-5 w-5 shrink-0 text-clinic-dark" />
          <span>{site.parking}</span>
        </li>
      </ul>
      <dl class="mt-6 space-y-1 text-[15px]">
        {
          clinicHours.summary.map((r) => (
            <div class="flex justify-between gap-4">
              <dt>
                {r.days}{r.note && <span class="text-slate-soft"> · {r.note}</span>}
              </dt>
              <dd class="whitespace-nowrap font-semibold tabular-nums text-ink">{r.time}</dd>
            </div>
          ))
        }
      </dl>
      <a href={site.mapsLink} target="_blank" rel="noopener noreferrer" class="btn-primary mt-8 w-full sm:w-auto">
        <Navigation class="h-4 w-4" /> Get directions
      </a>
    </div>
    <div class="flex flex-col">
      {/* Street view of the building, so visitors recognise it on arrival */}
      <figure class="reveal reveal-img relative overflow-hidden">
        <img
          src="/images/clinic-building.jpg"
          alt="Krystal Square building in Nagala Park with the blue Platinum Dental Care sign on the third floor"
          class="aspect-[1060/596] w-full object-cover"
          loading="lazy"
          decoding="async"
          width="1060"
          height="596"
        />
        {/* Pulsing outline around the clinic sign in the photo */}
        <span class="sign-ring" aria-hidden="true"></span>
        <figcaption class="absolute bottom-3 left-3 right-3 flex items-center gap-2 rounded-sm bg-white/95 px-3 py-1.5 text-[12.5px] font-semibold leading-snug text-ink sm:right-auto">
          <MapPin class="h-4 w-4 shrink-0 text-clinic" aria-hidden="true" />
          Look for the blue Platinum Dental Care sign on the 3rd floor.
        </figcaption>
      </figure>
      <div class="h-[300px] sm:h-[380px] lg:h-auto lg:min-h-[320px] lg:flex-1">
        <iframe
          title="Map showing the clinic location in Nagala Park, Kolhapur"
          src={site.mapEmbed}
          class="h-full w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  /* Box drawn over the "Platinum Dental Care" sign (positions are % of the photo) */
  .sign-ring {
    position: absolute;
    left: 56.8%;
    top: 32%;
    width: 31.6%;
    height: 11%;
    border: 2px solid #fff;
    border-radius: 4px;
    box-shadow: 0 0 0 1px rgba(26, 155, 215, 0.6);
    pointer-events: none;
    animation: sign-pulse 2.4s ease-in-out infinite;
  }
  @keyframes sign-pulse {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.04); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sign-ring { animation: none; opacity: 0.8; }
  }
</style>
