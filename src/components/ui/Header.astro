---
import { Menu, X, CalendarCheck } from '@lucide/astro';
import { nav } from '../../data/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => path === href;
---

<header id="top" class="sticky top-0 z-40 bg-white transition-shadow">
  <div class="wrap flex h-16 items-center justify-between md:h-[72px]">
    <Logo />
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-5 xl:gap-7 font-display text-[15px] font-semibold text-ink">
        {
          nav.map((n) => (
            <li>
              <a href={n.href} data-nav-link aria-current={isActive(n.href) ? 'page' : undefined} class:list={['link-underline py-1 hover:text-action aria-[current]:text-action', isActive(n.href) && 'text-action']}>{n.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/book" class="btn-primary !min-h-[40px] !px-3.5 !py-2 text-[14px] sm:!min-h-[46px] sm:!px-5 sm:!py-2.5 sm:text-[15px]">
        <CalendarCheck class="h-4 w-4" /> Book<span class="hidden sm:inline"> appointment</span>
      </a>
      <button
        type="button"
        class="-mr-2 grid h-11 w-11 place-items-center rounded text-ink lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu"
      >
        <span data-icon-open class="block"><Menu class="h-6 w-6" /></span>
        <span data-icon-close class="hidden"><X class="h-6 w-6" /></span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" aria-label="Mobile" class="max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-line bg-white shadow-[0_12px_24px_-12px_rgba(13,30,56,0.25)] lg:hidden" hidden>
    <ul class="wrap py-2">
      {
        nav.map((n) => (
          <li>
            <a href={n.href} data-menu-link data-nav-link aria-current={isActive(n.href) ? 'page' : undefined} class:list={['block border-b border-line py-3.5 font-display text-[17px] font-semibold aria-[current]:text-action', isActive(n.href) ? 'text-action' : 'text-ink']}>
              {n.label}
            </a>
          </li>
        ))
      }
      <li class="py-4">
        <a href="/book" data-menu-link class="btn-primary w-full">Book appointment</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('top');
  const onScroll = () => header?.classList.toggle('shadow-[0_1px_0_#DCE5EE]', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = toggle?.querySelector('[data-icon-open]');
  const iconClose = toggle?.querySelector('[data-icon-close]');

  const setOpen = (open: boolean) => {
    if (!toggle || !mobileNav) return;
    mobileNav.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconOpen?.classList.toggle('block', !open);
    iconClose?.classList.toggle('hidden', !open);
    iconClose?.classList.toggle('block', open);
  };

  toggle?.addEventListener('click', () => setOpen(mobileNav?.hidden ?? false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileNav && !mobileNav.hidden) { setOpen(false); toggle?.focus(); }
  });
  // Close the menu if the screen grows to desktop width (e.g. phone rotated / tablet)
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => m.matches && setOpen(false));
  document.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Scroll spy: highlight the menu item for the section in view.
  // Sections without their own menu item count towards a related one.
  const alias: Record<string, string> = {
    clinic: 'about',
    results: 'treatments',
    'patient-reviews': 'google-reviews',
    'contact-form': 'contact',
  };
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const navIds = new Set(navLinks.map((a) => a.hash.slice(1)).filter(Boolean));
  const spySections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
  let currentSpy: string | null = null;
  const setActive = (id: string | null) => {
    if (id === currentSpy) return;
    currentSpy = id;
    navLinks.forEach((a) => {
      const on = !!id && a.hash === `#${id}`;
      if (on) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
  };
  const spy = () => {
    // A line a third of the way down the screen; the last section starting above it is "current".
    const line = (header?.offsetHeight ?? 72) + window.innerHeight * 0.3;
    let active: string | null = null;
    for (const s of spySections) {
      if (s.getBoundingClientRect().top <= line) active = s.id;
      else break;
    }
    // At the very bottom of the page, the last section wins.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2 && spySections.length) {
      active = spySections[spySections.length - 1].id;
    }
    const mapped = active ? alias[active] ?? active : null;
    setActive(mapped && navIds.has(mapped) ? mapped : null);
  };
  if (navLinks.length && spySections.length) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { spy(); ticking = false; });
    }, { passive: true });
    window.addEventListener('resize', spy);
    spy();
  }
</script>
