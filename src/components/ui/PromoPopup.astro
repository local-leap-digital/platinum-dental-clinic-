---
// "Painless treatment" showcase: a small card that slides in at the
// bottom-left corner a moment after the page opens. It never blocks the page.
// The visitor can fold it into a small pulsing badge and open it again.
// On phones it starts folded as the badge, so it doesn't cover the content.
//
// TODO: replace DEVICE_NAME with the device's real name, and set DEVICE_IMAGE
// to its photo in /public/images (e.g. '/images/painless-device.jpg').
import { X } from '@lucide/astro';
import { waLink } from '../../utils/whatsapp';
import { site } from '../../data/site';

const DEVICE_NAME = 'Painless treatment technology';
const DEVICE_IMAGE = '';

const message = `Hello ${site.name}, I'd like to know more about your painless treatment and book a consultation.`;
---

<div id="painless" class="pl fixed left-4 z-30 md:left-6" data-state="hidden">
  <!-- Expanded card -->
  <aside
    class="pl-card w-[300px] overflow-hidden rounded-md bg-white shadow-[0_18px_44px_-10px_rgba(13,30,56,0.35),0_0_0_1px_#DCE5EE]"
    aria-label="Painless treatment"
  >
    <div class="pl-visual relative grid h-[132px] place-items-center overflow-hidden bg-gradient-to-br from-clinic-light via-white to-clinic-light">
      {
        DEVICE_IMAGE ? (
          <img src={DEVICE_IMAGE} alt={DEVICE_NAME} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
        ) : (
          <>
            <span class="pl-ring" aria-hidden="true" />
            <span class="pl-ring pl-ring-2" aria-hidden="true" />
            <span class="pl-ring pl-ring-3" aria-hidden="true" />
            <svg class="pl-tooth relative h-16 w-16 text-clinic" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path
                d="M32 14c-4-4-10-6-15-3-6 3-7 10-5 17 2 6 4 9 5 16 1 6 2 10 5 10 4 0 4-8 6-13 1-3 2-4 4-4s3 1 4 4c2 5 2 13 6 13 3 0 4-4 5-10 1-7 3-10 5-16 2-7 1-14-5-17-5-3-11-1-15 3Z"
                fill="white"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linejoin="round"
              />
              <path d="M24 30c2 2 4 3 8 3s6-1 8-3" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
              <circle cx="25" cy="24" r="1.8" fill="currentColor" />
              <circle cx="39" cy="24" r="1.8" fill="currentColor" />
            </svg>
          </>
        )
      }
      <span class="absolute left-3 top-3 rounded-full bg-mint px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.12em] text-white">
        Painless
      </span>
      <button
        type="button"
        data-pl-fold
        aria-label="Minimise"
        class="absolute right-2.5 top-2.5 grid h-7 w-7 place-items-center rounded-full bg-white/90 text-ink shadow-sm hover:bg-white"
      >
        <X class="h-3.5 w-3.5" />
      </button>
    </div>

    <div class="px-4 pb-4 pt-3.5">
      <p class="font-display text-[17px] font-bold leading-snug text-ink">{DEVICE_NAME}</p>
      <p class="mt-1 text-[13.5px] leading-snug text-slate">
        Our advanced device makes injections and treatment gentle and comfortable — no fear, no stress.
      </p>
      <a
        href={waLink(message)}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1.5 text-[14px] font-semibold text-action hover:underline"
      >
        Ask about it on WhatsApp <span aria-hidden="true">→</span>
      </a>
    </div>
  </aside>

  <!-- Folded badge -->
  <button
    type="button"
    data-pl-open
    class="pl-badge inline-flex items-center gap-2 rounded-full bg-white py-2 pl-2 pr-4 font-display text-[14px] font-bold text-ink shadow-[0_8px_24px_-6px_rgba(13,30,56,0.35),0_0_0_1px_#DCE5EE] hover:-translate-y-0.5"
    aria-label="Show painless treatment details"
  >
    <span class="pl-dot relative isolate grid h-7 w-7 place-items-center rounded-full bg-mint text-white">
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
        <path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    Painless treatment
  </button>
</div>

<style>
  /* Position: sit above the bottom bars once they appear */
  .pl { bottom: 16px; transition: bottom 400ms ease; }
  :global(html.is-scrolled) .pl { bottom: calc(126px + env(safe-area-inset-bottom)); }
  :global(html.is-scrolled.rb-closed) .pl { bottom: calc(74px + env(safe-area-inset-bottom)); }
  @media (min-width: 768px) {
    .pl, :global(html.is-scrolled.rb-closed) .pl { bottom: 24px; }
    :global(html.is-scrolled:not(.rb-closed)) .pl { bottom: 108px; }
  }

  /* States */
  .pl-card, .pl-badge { display: none; }
  .pl[data-state='open'] .pl-card { display: block; animation: pl-in 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.15) both; }
  .pl[data-state='folded'] .pl-badge { display: inline-flex; animation: pl-in 0.4s ease-out both; }
  @keyframes pl-in { from { opacity: 0; transform: translateY(24px) scale(0.96); } }

  /* Calm ripples around the tooth */
  .pl-ring {
    position: absolute;
    width: 76px;
    height: 76px;
    border-radius: 9999px;
    border: 2px solid rgba(26, 155, 215, 0.35);
    animation: pl-ripple 3s ease-out infinite;
  }
  .pl-ring-2 { animation-delay: 1s; }
  .pl-ring-3 { animation-delay: 2s; }
  @keyframes pl-ripple {
    from { transform: scale(0.8); opacity: 1; }
    to { transform: scale(2.6); opacity: 0; }
  }
  .pl-tooth { animation: pl-float 3.2s ease-in-out infinite; }
  @keyframes pl-float { 50% { transform: translateY(-5px); } }

  /* Pulse on the folded badge */
  .pl-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: #2fb37a;
    animation: pl-pulse 2s ease-out infinite;
    z-index: -1;
  }
  @keyframes pl-pulse { to { transform: scale(1.9); opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .pl-card, .pl-badge, .pl-ring, .pl-tooth, .pl-dot::after { animation: none !important; }
    .pl-ring { display: none; }
  }
</style>

<script>
  const box = document.getElementById('painless');
  if (box) {
    const isPhone = window.matchMedia('(max-width: 767px)').matches;
    setTimeout(() => {
      box.dataset.state = isPhone ? 'folded' : 'open';
    }, 2000);

    box.querySelector('[data-pl-fold]')?.addEventListener('click', () => {
      box.dataset.state = 'folded';
      box.querySelector<HTMLElement>('[data-pl-open]')?.focus({ preventScroll: true });
    });
    box.querySelector('[data-pl-open]')?.addEventListener('click', () => {
      box.dataset.state = 'open';
      box.querySelector<HTMLElement>('[data-pl-fold]')?.focus({ preventScroll: true });
    });
  }
</script>
