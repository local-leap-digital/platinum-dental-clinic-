---
import { site } from '../../data/site';

// Clinic logo mark + clinic name.
const { tone = 'dark' } = Astro.props;
const ink = tone === 'dark' ? '#13294B' : '#FFFFFF';
---

<a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} — home`}>
  <img src="/logo.png" alt="" class="h-10 w-10 shrink-0" width="40" height="40" />
  <span class="leading-none">
    <span class="block font-display text-[19px] font-bold tracking-tight" style={{ color: ink }}>{site.shortName}</span>
    <span class:list={['mt-0.5 block text-[10.5px] font-semibold uppercase tracking-[0.2em]', tone === 'dark' ? 'text-clinic-dark' : 'text-clinic']}>
      Dental Care
    </span>
  </span>
</a>
