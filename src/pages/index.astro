---
// Single-page site. Section order:
// Intro → About the clinic → Doctors → Treatments → Why choose us →
// Before & after → Patient video reviews → Google reviews → Contact → FAQs
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Gallery from '../components/sections/Gallery.astro';
import Doctors from '../components/sections/Doctors.astro';
import Treatments from '../components/sections/Treatments.astro';
import WhyChooseUs from '../components/sections/WhyChooseUs.astro';
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import VideoTestimonials from '../components/sections/VideoTestimonials.astro';
import GoogleReviews from '../components/sections/GoogleReviews.astro';
import Contact from '../components/sections/Contact.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import FAQ from '../components/sections/FAQ.astro';
---

<Layout preloadImage="/images/hero-consult.jpg">
  <Hero />
  <About />
  <Gallery />
  <Doctors />
  <Treatments />
  <WhyChooseUs />
  <BeforeAfter />
  <VideoTestimonials />
  <GoogleReviews />
  <Contact />
  <ContactForm />
  <FAQ tone="enamel" />
</Layout>
